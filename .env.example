# Comic Studio environment template — copy to .env and fill only what you use.

# Required for scenario generation and image rendering
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io

# Telegram approval/notifications (optional for local Web-only review)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=1045621572

# YouTube transcript fallback (optional)
SUPADATA_API_KEY=

# Notion scenario mirror (optional; comic mirror is not implemented yet)
NOTION_TOKEN=
NOTION_SCENARIOS_DB=
NOTION_COMICS_DB=

# Site publication (optional; without URL publication is skipped)
SITE_API_URL=
SITE_API_KEY=

# Social adapters are placeholders
TWITTER_BEARER_TOKEN=
MASTODON_INSTANCE=
MASTODON_TOKEN=

# Web API — secure local mode defaults
HOST=127.0.0.1
PORT=3000
# WEB_API_URL=http://127.0.0.1:3000
# API_BASE_URL=http://127.0.0.1:3000
# DATA_ROOT=/absolute/path/to/comic-studio/data
# PYTHON_BIN=/absolute/path/to/comic-studio/.venv/bin/python3

# Remote mode: required together when HOST is not localhost/loopback
# WEB_API_TOKEN=replace-with-a-long-random-token
# WEB_ALLOWED_ORIGINS=https://studio.example

# Public URL of Web UI used by Telegram bot for HTML-comic links.
# Default empty: bot sends only PNG photo (backward-compat).
# When set: bot appends '🔗 HTML: <WEB_PUBLIC_URL>/comics/<id>.html' caption
# and '🔗 Открыть HTML' inline button under rendered/published scenarios.
# Example: WEB_PUBLIC_URL=https://studio.example.com
# WEB_PUBLIC_URL=

# Process and retention limits (milliseconds/bytes)
WEB_INGEST_TIMEOUT_MS=180000
WEB_RENDER_TIMEOUT_MS=600000
WEB_PROCESS_OUTPUT_LIMIT=10485760
WEB_JOB_RETENTION_MS=604800000
WEB_ARTIFACT_RETENTION_MS=86400000
WEB_SHUTDOWN_GRACE_MS=15000
WEB_MAX_CONTENT_CHARS=50000
WEB_MAX_FEEDBACK_CHARS=5000
WEB_MAX_SEED=2147483647
WEB_REVISION_TIMEOUT_MS=180000
WEB_REVISION_OUTPUT_LIMIT=10485760
WEB_MAX_REVISION_FEEDBACK_COUNT=20
WEB_MAX_REVISION_HISTORY=10
WEB_LEGACY_RETENTION_MS=604800000

# Nightly batch
CRON_BATCH_SIZE=3
